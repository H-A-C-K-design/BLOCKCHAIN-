# MEMOCHECK Environment Variables Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Client Firebase Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server Firebase Admin Configuration (Secret - keep server-side only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# IPFS Provider Configuration (Server-side)
# Supported providers: "pinata", "custom"
IPFS_PROVIDER=pinata
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_TOKEN=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Blockchain EVM Configuration (Ethereum Sepolia, Base Sepolia, Polygon Amoy, or local)
CHAIN_ID=11155111
RPC_URL=https://rpc.sepolia.org
CONTRACT_ADDRESS=
# Server private key for signing issuance & revocation transactions on behalf of authorized institution
ISSUER_SIGNER_PRIVATE_KEY=

# Block Explorer URL Template (e.g. {txHash} placeholder)
BLOCK_EXPLORER_TX_URL_TEMPLATE=https://sepolia.etherscan.io/tx/{txHash}

# File Upload Limits
MAX_PDF_SIZE_MB=10
